{
  "name": "aviation-rights-vue-firebase",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit && tsc -p functions/tsconfig.json --noEmit",
    "build": "vue-tsc --noEmit && vite build && node scripts/build-functions.mjs",
    "build:emulator": "vue-tsc --noEmit && vite build --mode emulator && node scripts/build-functions.mjs",
    "build:functions": "node scripts/build-functions.mjs",
    "emulators": "firebase emulators:start --project demo-aviation-rights --config firebase.emulator.json --only auth,firestore,storage,functions,hosting",
    "seed": "node scripts/seed-emulator.mjs",
    "test": "tsx --test tests/*.test.ts",
    "deploy": "node scripts/deploy.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.25.0",
  "dependencies": {
    "@lucide/vue": "1.59.0",
    "firebase": "13.0.0",
    "vue": "3.5.44",
    "vue-router": "5.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@types/node": "26.6.5",
    "@vitejs/plugin-vue": "6.0.10",
    "esbuild": "0.28.2",
    "firebase-tools": "15.34.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vue-tsc": "3.3.13"
  }
}
